# CleanBot backend environment (installed to /etc/cleanbot/backend.env)
# Reload with: sudo systemctl restart cleanbot-backend

# ---------------------------------------------------------------------------
# HTTP API
# ---------------------------------------------------------------------------
CLEANBOT_API_HOST=0.0.0.0
CLEANBOT_API_PORT=8000
CLEANBOT_CORS_ORIGINS=*
CLEANBOT_LOG_LEVEL=INFO

# Generate with: openssl rand -hex 32
CLEANBOT_JWT_SECRET=replace-with-a-long-random-secret
CLEANBOT_ACCESS_TOKEN_MINUTES=480
CLEANBOT_REFRESH_TOKEN_DAYS=30

# ---------------------------------------------------------------------------
# Robot identity
# ---------------------------------------------------------------------------
CLEANBOT_ROBOT_ID=robot-alpha-01
CLEANBOT_ROBOT_NAME=CleanBot Pro (East Wing)
CLEANBOT_FIRMWARE_VERSION=cleanbot-esp32-1.0.0

# ---------------------------------------------------------------------------
# ROS 2 integration
# ---------------------------------------------------------------------------
ROS_DOMAIN_ID=0
CLEANBOT_MAP_FRAME=map
CLEANBOT_ODOM_FRAME=odom
CLEANBOT_BASE_FRAME=base_link

CLEANBOT_TOPIC_BATTERY=/battery_state
CLEANBOT_TOPIC_ODOM=/odom
CLEANBOT_TOPIC_SCAN=/scan
CLEANBOT_TOPIC_MAP=/map
CLEANBOT_TOPIC_AMCL=/amcl_pose
CLEANBOT_TOPIC_STATUS=/cleanbot/status
CLEANBOT_TOPIC_DETECTIONS=/cleanbot/detections
CLEANBOT_TOPIC_HARDWARE_COMMAND=/cleanbot/hardware_command
CLEANBOT_TOPIC_CMD_VEL=/cmd_vel
CLEANBOT_TOPIC_GOAL_POSE=/goal_pose

# Set to false on the real robot so live telemetry is used.
CLEANBOT_FORCE_SIMULATION=false
# Keep true so the app still works if ROS 2 fails to start.
CLEANBOT_SIMULATE_WHEN_ROS_MISSING=true
# Extra demo robot in the fleet list (set false in production).
CLEANBOT_ENABLE_SIM_ROBOT=false

CLEANBOT_DATABASE_PATH=/var/lib/cleanbot/cleanbot.db

# ---------------------------------------------------------------------------
# Users
# ---------------------------------------------------------------------------
# Default accounts (change these before exposing the Pi to a network):
#   operator@cleanbot.io / CleanBot#2026   (operator)
#   admin@cleanbot.io    / Admin#2026      (admin)
#   readonly@cleanbot.io / ReadOnly#2026   (readonly)
#
# Override with a JSON array. Passwords are hashed with PBKDF2 at startup.
# CLEANBOT_USERS=[{"id":"usr-1","username":"ops@example.com","email":"ops@example.com","full_name":"Ops","role":"operator","password":"replace-me"}]

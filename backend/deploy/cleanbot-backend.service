[Unit]
Description=CleanBot REST + WebSocket backend
Documentation=https://github.com/cleanbot/cleanbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__CLEANBOT_USER__
Group=__CLEANBOT_USER__
SupplementaryGroups=dialout
WorkingDirectory=__INSTALL_DIR__/backend
EnvironmentFile=/etc/cleanbot/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ROS_DISTRO=__ROS_DISTRO__

ExecStart=/bin/bash __INSTALL_DIR__/backend/deploy/run_backend.sh

Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT

# Hardening: the service only needs its data directory and the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/cleanbot
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

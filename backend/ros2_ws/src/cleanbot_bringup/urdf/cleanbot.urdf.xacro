<?xml version="1.0"?>
<!--
  CleanBot differential-drive robot description.

  Frames:
    base_footprint -> base_link -> {left_wheel, right_wheel, caster_*, laser, imu, cleaning_deck}

  The wheel joints are continuous and driven by the hardware driver through
  /odom; joint_state_publisher is only needed for RViz visualisation.
-->
<robot name="cleanbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="wheel_separation" value="0.34"/>
  <xacro:property name="base_length" value="0.42"/>
  <xacro:property name="base_width" value="0.34"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_z" value="0.095"/>
  <xacro:property name="laser_z" value="0.235"/>

  <material name="cleanbot_blue">
    <color rgba="0.129 0.400 0.741 1.0"/>
  </material>
  <material name="cleanbot_dark_blue">
    <color rgba="0.055 0.184 0.353 1.0"/>
  </material>
  <material name="cleanbot_white">
    <color rgba="0.980 0.988 1.0 1.0"/>
  </material>
  <material name="cleanbot_black">
    <color rgba="0.08 0.10 0.14 1.0"/>
  </material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
               iyy="${m * (x*x + z*z) / 12.0}" iyz="0"
               izz="${m * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m * (3*r*r + h*h) / 12.0}" ixy="0" ixz="0"
               iyy="${m * (3*r*r + h*h) / 12.0}" iyz="0"
               izz="${m * r*r / 2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ================================================================== -->
  <!-- Base                                                               -->
  <!-- ================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="cleanbot_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="6.5" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- White top shell -->
  <link name="top_shell">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length - 0.04} ${base_width - 0.04} 0.05"/>
      </geometry>
      <material name="cleanbot_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length - 0.04} ${base_width - 0.04} 0.05"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="1.2" x="${base_length - 0.04}" y="${base_width - 0.04}" z="0.05"/>
  </link>

  <joint name="top_shell_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_shell"/>
    <origin xyz="0 0 ${base_height / 2.0 + 0.025}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================== -->
  <!-- Drive wheels                                                       -->
  <!-- ================================================================== -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="cleanbot_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.45" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${y_offset} ${wheel_radius - base_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" y_offset="${wheel_separation / 2.0}"/>
  <xacro:wheel prefix="right" y_offset="${-wheel_separation / 2.0}"/>

  <!-- ================================================================== -->
  <!-- Casters                                                            -->
  <!-- ================================================================== -->
  <xacro:macro name="caster" params="prefix x_offset">
    <link name="${prefix}_caster">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.03"/>
        </geometry>
        <material name="cleanbot_dark_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.03"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.15" r="0.03" h="0.06"/>
    </link>
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster"/>
      <origin xyz="${x_offset} 0 ${0.03 - base_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster prefix="front" x_offset="0.16"/>
  <xacro:caster prefix="rear" x_offset="-0.16"/>

  <!-- ================================================================== -->
  <!-- LiDAR                                                              -->
  <!-- ================================================================== -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.05"/>
      </geometry>
      <material name="cleanbot_dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.05"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.19" r="0.035" h="0.05"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0 0 ${laser_z - base_z}" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame"/>
  <joint name="laser_frame_joint" type="fixed">
    <parent link="laser"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================== -->
  <!-- IMU                                                                -->
  <!-- ================================================================== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="cleanbot_dark_blue"/>
    </visual>
    <xacro:box_inertia m="0.02" x="0.03" y="0.03" z="0.01"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.05 0 ${base_height / 2.0 + 0.06}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================== -->
  <!-- Cleaning deck (brush + vacuum)                                     -->
  <!-- ================================================================== -->
  <link name="cleaning_deck">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.26 0.04"/>
      </geometry>
      <material name="cleanbot_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.26 0.04"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="1.4" x="0.20" y="0.26" z="0.04"/>
  </link>

  <joint name="cleaning_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cleaning_deck"/>
    <origin xyz="${base_length / 2.0 - 0.08} 0 ${-base_height / 2.0 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================== -->
  <!-- Wheel visual rotation source                                       -->
  <!-- ================================================================== -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${wheel_radius * 2.0}</wheel_diameter>
      <max_wheel_torque>12</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
    </plugin>
  </gazebo>

</robot>
